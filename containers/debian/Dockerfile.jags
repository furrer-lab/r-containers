# Layer 2: JAGS and rjags.
#
# Installs the JAGS system package and rjags on top of the syslibs base.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.description="R-hub-based image with JAGS and rjags."
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.authors="Jonas I. Liechti <j-i-l@t4d.ch>"
LABEL org.opencontainers.image.source="https://github.com/furrer-lab/r-containers"
LABEL org.opencontainers.image.documentation="https://github.com/furrer-lab/r-containers"
LABEL org.opencontainers.image.vendor="Furrer Lab"

RUN apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends \
  jags \
  && rm -rf /var/lib/apt/lists/*

# Install rjags against the system JAGS installation.
# Debian's libjags.so is built against libstdc++, but the r-hub debian-clang
# base forces -stdlib=libc++ via ~/.R/Makevars, breaking the ABI. Compile
# rjags with clang against libstdc++ by stripping the libc++ flag for this
# install only; bases without the flag are unaffected.
RUN if [ -f /root/.R/Makevars ] && grep -q 'stdlib=libc++' /root/.R/Makevars; then \
      sed 's/ -stdlib=libc++//g' /root/.R/Makevars > /tmp/rjags-Makevars && \
      R_MAKEVARS_USER=/tmp/rjags-Makevars \
        R -e "install.packages('rjags', lib=.Library); if (!requireNamespace('rjags', quietly=TRUE)) stop('Failed to install: rjags')" && \
      rm /tmp/rjags-Makevars; \
    else \
      R -e "install.packages('rjags', lib=.Library); if (!requireNamespace('rjags', quietly=TRUE)) stop('Failed to install: rjags')"; \
    fi
