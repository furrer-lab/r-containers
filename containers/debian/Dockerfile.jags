# Layer 2: JAGS and rjags.
#
# Installs the JAGS system package and rjags on top of the syslibs base.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.description="R-hub-based image with JAGS and rjags." \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.authors="Jonas I. Liechti <j-i-l@t4d.ch>" \
      org.opencontainers.image.source="https://github.com/furrer-lab/r-containers" \
      org.opencontainers.image.documentation="https://github.com/furrer-lab/r-containers" \
      org.opencontainers.image.vendor="Furrer Lab"

LABEL org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.authors="Jonas I. Liechti <j-i-l@t4d.ch>"

RUN apt-get update --allow-releaseinfo-change && apt-get install -y --no-install-recommends \
  jags \
  && rm -rf /var/lib/apt/lists/*

# Install rjags against the system JAGS installation.
RUN R -e "install.packages('rjags', lib=.Library); if (!requireNamespace('rjags', quietly=TRUE)) stop('Failed to install: rjags')"
