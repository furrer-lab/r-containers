ARG BASE_IMAGE
ARG JAGS
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.description="R-hub-based image with JAGS and rjags."
LABEL org.opencontainers.image.licenses="GPL-3.0-only"
LABEL org.opencontainers.image.authors="Jonas I. Liechti <j-i-l@t4d.ch>"
LABEL org.opencontainers.image.source="https://github.com/furrer-lab/r-containers"
LABEL org.opencontainers.image.documentation="https://github.com/furrer-lab/r-containers"
LABEL org.opencontainers.image.vendor="Furrer Lab"

ARG COMPILER
ARG JAGS
ADD https://sourceforge.net/projects/mcmc-jags/files/JAGS/4.x/Source/$JAGS.tar.gz/download /tmp/jags.tar.gz
WORKDIR /tmp/
RUN tar -xf jags.tar.gz && rm jags.tar.gz
WORKDIR /tmp/$JAGS
RUN if [ "$COMPILER" = "clang" ]; then RCC=/usr/bin/clang RCXX="/usr/bin/clang++ -std=gnu++17 -stdlib=libc++"; else RCC=/usr/bin/gcc RCXX=/usr/bin/g++; fi \
  && LD="llvm-ld" CC="${RCC}" CXX="${RCXX}" ./configure --with-blas="-L/opt/R/devel-valgrind/lib/R/lib -lRblas" --with-lapack="-L/opt/R/devel-valgrind/lib/R/lib -lRlapack" --libdir=/usr/local/lib \
  && make && make install
ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"
# rjags 5.x requires JAGS >= 5.0.0. JAGS 5 is not packaged by the supported
# distributions and this image builds JAGS 4.x from source. Pin rjags 4-17,
# the last release compatible with JAGS 4.x.y.
RUN R -e "install.packages('coda', lib=.Library); if (!requireNamespace('coda', quietly=TRUE)) stop('Failed to install: coda')"
RUN R -e "install.packages('https://cran.r-project.org/src/contrib/Archive/rjags/rjags_4-17.tar.gz', repos=NULL, type='source', lib=.Library, configure.args='--enable-rpath'); if (!requireNamespace('rjags', quietly=TRUE)) stop('Failed to install: rjags')"
